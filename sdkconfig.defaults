# Board target: ESP32-C3
CONFIG_IDF_TARGET="esp32c3"

# Use the built-in USB Serial/JTAG console where the board exposes it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# This firmware does not require external PSRAM.
CONFIG_SPIRAM=n

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Single 3 MB factory app, no OTA. See partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: NimBLE, central + observer only. The brush accepts exactly one
# client, so a single connection is all that is needed.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# We keep our own cache in our own NVS namespace; NimBLE does not need to
# persist bonds for an unpaired, unencrypted connection.
CONFIG_BT_NIMBLE_NVS_PERSIST=n

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
